{
  "name": "@deepseek-ai/dsh-credentials-keypool",
  "description": "Rotating credentials provider: resolves a pool reference to one of its member credentials by policy, delegating storage to the file-backed provider, for the DeepSeek Harness",
  "version": "0.1.0-rc.8",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/later0day/deepseek-harness.git",
    "directory": "packages/credentials/keypool"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/invariant.js",
    "lib/types/**/*.d.ts",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && tsdown",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "bundle": "tsdown",
    "watch": "tsdown --watch",
    "test": "vitest run"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-credentials-local": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-invariants": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.1",
    "react": "^18.3.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-credentials": "link:/Users/later0day/Desktop/DSH/deepseek-harness/packages/credentials/credentials",
    "@deepseek-ai/dsh-credentials-local": "link:/Users/later0day/Desktop/DSH/deepseek-harness/packages/credentials/credentials-local",
    "@deepseek-ai/dsh-invariants": "link:/Users/later0day/Desktop/DSH/deepseek-harness/packages/runtime-diagnostics/invariants",
    "@deepseek-ai/dsh-settings": "link:/Users/later0day/Desktop/DSH/deepseek-harness/packages/settings/settings",
    "@types/node": "^24.0.0",
    "lightningcss": "^1.33.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  }
}
